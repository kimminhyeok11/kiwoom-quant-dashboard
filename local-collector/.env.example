# === 키움 REST API 자격 증명 ===
# 모의투자 App Key/Secret (mockapi.kiwoom.com)
KIWOOM_MOCK_APP_KEY=your-mock-app-key
KIWOOM_MOCK_APP_SECRET=your-mock-app-secret
KIWOOM_MOCK_ACCOUNT=your-mock-account-number

# 실투자 App Key/Secret (api.kiwoom.com) - 데이터 수집 전용
KIWOOM_LIVE_APP_KEY=your-live-app-key
KIWOOM_LIVE_APP_SECRET=your-live-app-secret

# === 서버 동기화 ===
# Vercel에 배포된 서버 주소
SERVER_URL=https://your-app.vercel.app
# 서버의 LOCAL_RESEARCH_NODE_TOKEN과 동일한 값
SERVER_TOKEN=your-research-node-token

# === 수집 설정 ===
# 수집할 종목 수 (거래대금 상위)
MAX_UNIVERSE_SYMBOLS=20
# 분봉 수집 간격(초) - 장중에만 작동
MINUTE_COLLECT_INTERVAL=60
